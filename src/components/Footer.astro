---
// src/components/Footer.astro
const year = new Date().getFullYear()
---

<footer class="bg-gray-900 text-gray-400 py-8 border-t border-gray-800">
  <div class="container mx-auto px-4 text-center">
    <p class="text-xs text-gray-400 font-medium">
      © {year} Salterio · Fred Alvarez Labs. Todos los derechos reservados.
    </p>
    
    <!-- Enlaces discretos de políticas y seguridad requeridos por tiendas y normativas -->
    <nav aria-label="Enlaces legales y políticas" class="mt-3">
      <ul class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-xs text-gray-400">
        <li>
          <a 
            href="/privacidad" 
            class="hover:text-gray-300 transition-colors duration-200"
          >
            Política de Privacidad
          </a>
        </li>
        <li class="hidden sm:inline text-gray-700" aria-hidden="true">•</li>
        <li>
          <a 
            href="/seguridad-de-datos" 
            class="hover:text-gray-300 transition-colors duration-200"
          >
            Seguridad de los Datos
          </a>
        </li>
        <li class="hidden sm:inline text-gray-700" aria-hidden="true">•</li>
        <li>
          <a 
            href="mailto:soporte@fredalvarezlabs.com" 
            class="hover:text-gray-300 transition-colors duration-200"
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
